  "tools": [
    {
      "id": "olo.business/process-intake",
      "name": "olo.business/process-intake",
      "enabled": true,
      "revision": 1,
      "version": "0.1.0",
      "packageDigest": "bf20ef728e02fe7bff7abc91431664f944d9dd7f121e3007454e2496ca60756f",
      "definition": {
        "id": "olo.business/process-intake",
        "name": "olo.business/process-intake",
        "description": "Submit a bounded source-pinned document job and collect its confirmed result. Submission and each result access record a fenced target receipt. No payment, account, model or approval action occurs.",
        "actions": [
          {
            "name": "document.process",
            "resourceKinds": [
              "CUSTOM"
            ]
          }
        ],
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "intakeId": {
              "description": "Opaque intake identifier from the approved repository",
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "useCase": {
              "description": "ocr, medical, vlsic, loan, invoice, support, itsm or onboarding",
              "maxLength": 32,
              "type": "string"
            }
          },
          "required": [
            "intakeId",
            "useCase"
          ],
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": false,
          "properties": {
            "intakeId": {
              "description": "Authorized intake identifier",
              "type": "string"
            },
            "manifestSha256": {
              "description": "Exact observed intake manifest SHA-256",
              "type": "string"
            },
            "processing": {
              "additionalProperties": false,
              "description": "Processed document evidence and deterministic report",
              "properties": {
                "report": {
                  "additionalProperties": false,
                  "description": "Deterministic business report",
                  "properties": {
                    "draft": {
                      "description": "Reviewable draft; never sent by processing",
                      "type": "string"
                    },
                    "findings": {
                      "description": "Findings; independent from execution state",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "checkId": {
                            "description": "Stable rule/check identifier",
                            "type": "string"
                          },
                          "detail": {
                            "description": "Deterministic reason",
                            "type": "string"
                          },
                          "evidence": {
                            "description": "Supporting source locations",
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "documentId": {
                                  "description": "Document identifier; empty for a structured pointer",
                                  "type": "string"
                                },
                                "engine": {
                                  "description": "Extraction or deterministic-rule engine",
                                  "type": "string"
                                },
                                "line": {
                                  "description": "One-based line; zero for a structured pointer",
                                  "maximum": 2147483647,
                                  "minimum": -2147483648,
                                  "type": "integer"
                                },
                                "page": {
                                  "description": "One-based page; zero for a structured pointer",
                                  "maximum": 2147483647,
                                  "minimum": -2147483648,
                                  "type": "integer"
                                },
                                "pointer": {
                                  "description": "JSON pointer for structured evidence; empty for source text",
                                  "type": "string"
                                },
                                "quote": {
                                  "description": "Exact source quote; empty for a structured pointer",
                                  "type": "string"
                                },
                                "rotation": {
                                  "description": "Applied right-angle orientation correction",
                                  "maximum": 2147483647,
                                  "minimum": -2147483648,
                                  "type": "integer"
                                },
                                "sha256": {
                                  "description": "Original document SHA-256; empty for a structured pointer",
                                  "type": "string"
                                },
                                "sourceId": {
                                  "description": "Source identifier",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "documentId",
                                "engine",
                                "line",
                                "page",
                                "pointer",
                                "quote",
                                "rotation",
                                "sha256",
                                "sourceId"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "status": {
                            "description": "pass, fail, needs review or unsupported",
                            "type": "string"
                          },
                          "values": {
                            "description": "Observed source values, preserving conflicts",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "checkId",
                          "detail",
                          "evidence",
                          "status",
                          "values"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "nextActions": {
                      "description": "Outstanding reviewer work",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "summary": {
                      "description": "Deterministic report description",
                      "type": "string"
                    }
                  },
                  "required": [
                    "draft",
                    "findings",
                    "nextActions",
                    "summary"
                  ],
                  "type": "object"
                },
                "sources": {
                  "description": "Bounded extracted source pages",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "documentId": {
                        "description": "Document identifier",
                        "type": "string"
                      },
                      "engine": {
                        "description": "Extraction engine",
                        "type": "string"
                      },
                      "page": {
                        "description": "One-based page",
                        "maximum": 2147483647,
                        "minimum": -2147483648,
                        "type": "integer"
                      },
                      "rotation": {
                        "description": "Applied orientation correction",
                        "maximum": 2147483647,
                        "minimum": -2147483648,
                        "type": "integer"
                      },
                      "sha256": {
                        "description": "Original document SHA-256",
                        "type": "string"
                      },
                      "sourceId": {
                        "description": "Source page identifier",
                        "type": "string"
                      },
                      "text": {
                        "description": "Extracted source text",
                        "type": "string"
                      }
                    },
                    "required": [
                      "documentId",
                      "engine",
                      "page",
                      "rotation",
                      "sha256",
                      "sourceId",
                      "text"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "report",
                "sources"
              ],
              "type": "object"
            }
          },
          "required": [
            "intakeId",
            "manifestSha256",
            "processing"
          ],
          "type": "object"
        },
        "reconciliation": "MANUAL"
      },
