# The same published Quickstart supplies the server AND the Linux client archive.
TOOLGATE_QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev-f6b503f4a378-37978665914-1
TOOLGATE_HTTP_PORT=18091
TOOLGATE_TLS_PORT=18451
# Linux hosts: set these to `id -u` and `id -g`. Windows users can keep 1000.
LOCAL_UID=1000
LOCAL_GID=1000
# start.bat selects any available prepared device in ReadAndWriteDeviceGroup.
# -Win restricts selection to Windows. prepare-windows.ps1 registers public profiles.
# Optional public device export to import from another host:
TOOLGATE_WINDOWS_PROFILES=
# Only the AI runner receives the model key. Leave empty for --smoke.
# Create your OpenRouter key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Existing installations: complete first-login changes and provide these privately.
TOOLGATE_ADMIN_USERNAME=admin
TOOLGATE_ADMIN_PASSWORD=
TOOLGATE_REVIEWER1_USERNAME=reviewer-1
TOOLGATE_REVIEWER1_PASSWORD=
TOOLGATE_REVIEWER2_USERNAME=reviewer-2
TOOLGATE_REVIEWER2_PASSWORD=
