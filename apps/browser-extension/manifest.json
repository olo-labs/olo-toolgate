{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "ToolGate Connect",
  "version": "0.10.0",
  "description": "Connect this computer to ToolGate with explicit installation and enrollment approval.",
  "permissions": ["activeTab", "nativeMessaging", "storage", "downloads", "downloads.open"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"], "js": ["bridge.js"], "run_at": "document_idle"}]
}
