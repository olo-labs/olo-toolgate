{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/runtime.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "AuthorizationRequest",
  "$ref": "#/$defs/AuthorizationRequest",
  "$defs": {
    "AuthorizationRequest": {
      "type": "object",
      "description": "Runtime request; principal context and resource identity are derived by the gateway, never asserted by the caller.",
      "additionalProperties": false,
      "properties": {
        "toolId": {"$ref": "identifiers.schema.json#/$defs/Identifier"},
        "action": {"$ref": "identifiers.schema.json#/$defs/Identifier"},
        "arguments": {"type": "object", "maxProperties": 128}
      },
      "required": ["toolId", "action", "arguments"]
    },
    "RuntimeAuditEvent": {
      "type": "object",
      "description": "Sanitized authorization evaluation event; hashes replace raw arguments and resource locators. A decision is not execution success.",
      "additionalProperties": false,
      "properties": {
        "timestampUnixMs": {"type": "integer", "minimum": 0},
        "context": {"$ref": "common.schema.json#/$defs/RequestContext"},
        "toolId": {"$ref": "identifiers.schema.json#/$defs/Identifier"},
        "action": {"$ref": "identifiers.schema.json#/$defs/Identifier"},
        "resourceDigest": {"$ref": "identifiers.schema.json#/$defs/Sha256"},
        "argumentsDigest": {"$ref": "identifiers.schema.json#/$defs/Sha256"},
        "decision": {"$ref": "policy.schema.json#/$defs/PolicyDecision"},
        "traceId": {"type": "string", "pattern": "^[a-f0-9]{32}$"}
      },
      "required": ["timestampUnixMs", "context", "toolId", "action", "resourceDigest", "argumentsDigest", "decision", "traceId"]
    }
  }
}
