{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/deployment.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "DesiredState",
  "$ref": "#/$defs/DesiredState",
  "$defs": {
    "DeploymentAssignment": {
      "type": "object",
      "description": "Organization assignment with independent Marketplace evidence; grants no runtime permission.",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "release": {
          "$ref": "package.schema.json#/$defs/MarketplaceRelease"
        },
        "organizationKeyId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "organizationSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "desiredPresence": {
          "type": "boolean"
        }
      },
      "required": [
        "assignmentId",
        "deviceId",
        "release",
        "organizationKeyId",
        "organizationSignature",
        "desiredPresence"
      ]
    },
    "DesiredState": {
      "type": "object",
      "description": "Versioned desired package assignments reconciled by an endpoint.",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "deployment.schema.json#/$defs/DeploymentAssignment"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "deviceId",
        "revision",
        "assignments"
      ]
    }
  }
}
