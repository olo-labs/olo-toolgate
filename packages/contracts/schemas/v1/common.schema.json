{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/common.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ContractSet",
  "$ref": "#/$defs/ContractSet",
  "$defs": {
    "ContractSet": {
      "type": "object",
      "description": "Identifies the shared contract set, independently of product versions.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "const": "olo-toolgate-contracts"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "RequestContext": {
      "type": "object",
      "description": "Safe correlation and principal identifiers; contains no credentials.",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "userId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "requestId",
        "tenantId",
        "userId",
        "agentId"
      ]
    }
  }
}
