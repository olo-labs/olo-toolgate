  "protocolVersion": 2,
  "tools": [
    {
      "toolId": "hotfolder.list",
      "action": "list",
      "description": "List the bounded protected folder inventory.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "toolId": "hotfolder.read_text",
      "action": "read",
      "description": "Read bounded UTF-8 text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "toolId": "hotfolder.write_text",
      "action": "write",
      "description": "Atomically replace bounded UTF-8 text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "path",
          "text"
        ]
      }
    },
    {
      "toolId": "hotfolder.append_text",
      "action": "append",
      "description": "Serialize and atomically append bounded text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "path",
          "text"
        ]
      }
    },
    {
      "toolId": "hotfolder.mkdir",
      "action": "mkdir",
      "description": "Create one protected directory.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "toolId": "hotfolder.file_info",
      "action": "info",
      "description": "Read file metadata without content.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "toolId": "hotfolder.search_text",
      "action": "search",
      "description": "Find literal text in one authorized file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "path",
          "query"
        ]
      }
    },
    {
      "toolId": "hotfolder.watch_events",
      "action": "events",
      "description": "Poll a bounded service event window.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "epoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "after"
        ]
      }
    },
    {
      "toolId": "hotfolder.hash",
      "action": "hash",
      "description": "SHA-256 of one authorized file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "toolId": "hotfolder.move",
      "action": "move",
      "description": "Move a regular file; authorize both endpoints.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path",
          "destination"
        ]
      }
    },
    {
      "toolId": "hotfolder.copy",
      "action": "copy",
      "description": "Copy a regular file; authorize both endpoints.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path",
          "destination"
        ]
      }
    },
    {
      "toolId": "hotfolder.list_events",
      "action": "events",
      "description": "Read a bounded service event window.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "epoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "after"
        ]
      }
    },
    {
      "toolId": "calculator.evaluate",
      "action": "evaluate",
      "description": "Evaluate bounded arithmetic without code execution.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    {
      "toolId": "text.transform",
      "action": "transform",
      "description": "Transform bounded UTF-8 text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536
          },
          "mode": {
            "type": "string",
            "enum": [
              "upper",
              "lower",
              "trim"
            ]
          }
        },
        "required": [
          "text",
          "mode"
        ]
      }
    },
    {
      "toolId": "json.validate",
      "action": "validate",
      "description": "Validate JSON without evaluating code.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "toolId": "hash.sha256",
      "action": "hash",
      "description": "SHA-256 of bounded UTF-8 text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ]
      }
