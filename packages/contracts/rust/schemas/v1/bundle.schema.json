{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/bundle.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "SignedPolicyBundle",
  "$ref": "#/$defs/SignedPolicyBundle",
  "$defs": {
    "BundleHeader": {
      "type": "object",
      "description": "Strict JWS protected header; no remote or embedded keys and no algorithm negotiation.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "const": "RS256"
        },
        "typ": {
          "type": "string",
          "const": "toolgate-policy-bundle+jws"
        },
        "kid": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ]
    },
    "SignedPolicyBundle": {
      "type": "object",
      "description": "RFC 7515 compact JWS; payload and hash must both verify before adoption.",
      "additionalProperties": false,
      "properties": {
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 2000000
        }
      },
      "required": [
        "jws"
      ]
    },
    "BundlePublishRequest": {
      "type": "object",
      "description": "Publish a consistent directory snapshot or roll back into a new sequence. Requires Idempotency-Key.",
      "additionalProperties": false,
      "properties": {
        "directoryRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lifetimeMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "graceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "gracePolicyIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "rollbackOf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "directoryRevision",
        "expectedSequence",
        "lifetimeMs",
        "graceMs"
      ]
    }
  }
}
