{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/bundle.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "SignedPolicyBundle",
  "$ref": "#/$defs/SignedPolicyBundle",
  "$defs": {
    "BundleRule": {
      "type": "object",
      "description": "Exact tenant-scoped compiled policy; empty identity dimensions are unrestricted. BLOCK has precedence.",
      "additionalProperties": false,
      "properties": {
        "policyId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "resource": {
          "$ref": "resource.schema.json#/$defs/ResourceDescriptor"
        },
        "graceAllowed": {
          "type": "boolean",
          "description": "Explicit administrator classification as a low-risk read; never inferred from operation names."
        },
        "effect": {
          "$ref": "bundle.schema.json#/$defs/BundleEffect"
        }
      },
      "required": [
        "policyId",
        "userIds",
        "agentIds",
        "deviceIds",
        "toolId",
        "action",
        "resource",
        "graceAllowed",
        "effect"
      ]
    },
    "BundleEffect": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK"
      ]
    },
    "CompiledPolicy": {
      "type": "object",
      "description": "Version 1 deterministic exact-match rules, with unconditional default deny.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "bundle.schema.json#/$defs/BundleRule"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "formatVersion",
        "rules"
      ]
    },
    "BundleHeader": {
      "type": "object",
      "description": "Strict JWS protected header; no remote or embedded keys and no algorithm negotiation.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "const": "RS256"
        },
        "typ": {
          "type": "string",
          "const": "toolgate-policy-bundle+jws"
        },
        "kid": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ]
    },
    "BundlePayload": {
      "type": "object",
      "description": "Signed version, trust domain, immutable policy bytes and bounded freshness claims.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 1
        },
        "issuer": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "audience": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "directoryRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "policySha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "policy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 1048576
        },
        "rollbackOf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "formatVersion",
        "issuer",
        "audience",
        "tenantId",
        "sequence",
        "version",
        "directoryRevision",
        "issuedAtUnixMs",
        "expiresAtUnixMs",
        "graceMs",
        "policySha256",
        "policy"
      ]
    },
    "SignedPolicyBundle": {
      "type": "object",
      "description": "RFC 7515 compact JWS; payload and hash must both verify before adoption.",
      "additionalProperties": false,
      "properties": {
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 1500000
        }
      },
      "required": [
        "jws"
      ]
    },
    "BundlePublishRequest": {
      "type": "object",
      "description": "Publish a consistent directory snapshot or roll back into a new sequence. Requires Idempotency-Key.",
      "additionalProperties": false,
      "properties": {
        "directoryRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lifetimeMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "graceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "gracePolicyIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "rollbackOf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "directoryRevision",
        "expectedSequence",
        "lifetimeMs",
        "graceMs"
      ]
    }
  }
}
