{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/control.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ControlSnapshot",
  "$ref": "#/$defs/ControlSnapshot",
  "$defs": {
    "ControlUser": {
      "type": "object",
      "description": "Tenant-scoped users configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "access": {
          "$ref": "control.schema.json#/$defs/UserAccess"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision"
      ]
    },
    "ControlUserPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTeam": {
      "type": "object",
      "description": "Tenant-scoped teams configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 512
        },
        "roleIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "userIds"
      ]
    },
    "ControlTeamPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlAgent": {
      "type": "object",
      "description": "Tenant-scoped agents configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlAgentPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTool": {
      "type": "object",
      "description": "Tenant-scoped tools configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition": {
          "$ref": "tool.schema.json#/$defs/ToolDefinition"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "definition"
      ]
    },
    "ControlToolPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlPolicy": {
      "type": "object",
      "description": "Tenant-scoped policies configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "resource": {
          "$ref": "resource.schema.json#/$defs/ResourceDescriptor"
        },
        "decision": {
          "$ref": "policy.schema.json#/$defs/Decision",
          "enum": [
            "ALLOW",
            "ASK",
            "BLOCK"
          ]
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "teamIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "toolId",
        "action",
        "resource",
        "decision",
        "userIds",
        "teamIds",
        "agentIds",
        "deviceIds"
      ]
    },
    "ControlPolicyPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlDevice": {
      "type": "object",
      "description": "Tenant-scoped devices configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlDevicePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlSnapshot": {
      "type": "object",
      "description": "Versioned configuration data. Contains no credentials or executable code.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 1
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 512
        }
      },
      "required": [
        "formatVersion",
        "tenantId",
        "revision",
        "users",
        "teams",
        "agents",
        "tools",
        "policies",
        "devices"
      ]
    },
    "ControlImportMode": {
      "type": "string",
      "enum": [
        "MERGE",
        "REPLACE"
      ]
    },
    "ControlImportRequest": {
      "type": "object",
      "description": "Validate and diff before applying a bounded configuration transaction.",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "control.schema.json#/$defs/ControlSnapshot"
        },
        "mode": {
          "$ref": "control.schema.json#/$defs/ControlImportMode"
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot",
        "mode",
        "dryRun"
      ]
    },
    "ControlChangeKind": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "DELETE"
      ]
    },
    "ControlEntityKind": {
      "type": "string",
      "enum": [
        "USER",
        "TEAM",
        "AGENT",
        "TOOL",
        "POLICY",
        "DEVICE",
        "ROLE"
      ]
    },
    "ControlChange": {
      "type": "object",
      "description": "Deterministic import diff without payload or credential material.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "control.schema.json#/$defs/ControlEntityKind"
        },
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operation": {
          "$ref": "control.schema.json#/$defs/ControlChangeKind"
        }
      },
      "required": [
        "kind",
        "id",
        "operation"
      ]
    },
    "ControlImportResult": {
      "type": "object",
      "description": "Import validation/diff result with the current tenant revision.",
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlChange"
          },
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "applied",
        "revision",
        "changes"
      ]
    },
    "ControlAudit": {
      "type": "object",
      "description": "Append-only mutation metadata; payloads and credentials are excluded.",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "actorId": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "operation": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "target": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "sequence",
        "tenantId",
        "actorId",
        "operation",
        "target",
        "revision",
        "requestId",
        "occurredAt",
        "requestDigest"
      ]
    },
    "ControlAuditPage": {
      "type": "object",
      "description": "Cursor page of audit mutation metadata.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAudit"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "required": [
        "items"
      ]
    },
    "UserRole": {
      "type": "string",
      "description": "Organization portal role. Assignment alone is not an identity credential.",
      "enum": [
        "BASIC",
        "ADMINISTRATOR",
        "SUPER_ADMIN"
      ]
    },
    "UserPrivilegeTemplate": {
      "type": "string",
      "description": "Built-in additive privilege template; Gateway policy remains mandatory.",
      "enum": [
        "TOOL_USER",
        "IT_CLOUD_ADMIN",
        "APPROVER"
      ]
    },
    "UserAccess": {
      "type": "object",
      "description": "Tenant-scoped role and privilege assignment. Device groups are directory teams containing device IDs.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "control.schema.json#/$defs/UserRole"
        },
        "templateIds": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/UserPrivilegeTemplate"
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "deviceGroupIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "roleIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "required": [
        "role",
        "templateIds",
        "deviceGroupIds"
      ]
    },
    "AdminSession": {
      "type": "object",
      "description": "Server-verified administrator portal session.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "control.schema.json#/$defs/UserRole"
        }
      },
      "required": [
        "role"
      ]
    },
    "RoleDeviceScope": {
      "type": "string",
      "enum": [
        "NONE",
        "ALL",
        "GROUPS"
      ]
    },
    "RoleRules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fixed capability templates narrowed by device scope and optional tool allowlist. GROUPS requires nonempty group IDs; NONE and ALL require empty groups, validated by Control. Policies authorize each call.",
      "properties": {
        "templateIds": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/UserPrivilegeTemplate"
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "deviceScope": {
          "$ref": "control.schema.json#/$defs/RoleDeviceScope"
        },
        "deviceGroupIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "toolIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "templateIds",
        "deviceScope",
        "deviceGroupIds",
        "toolIds"
      ]
    },
    "ControlRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "portalRole": {
          "$ref": "control.schema.json#/$defs/UserRole"
        },
        "rules": {
          "$ref": "control.schema.json#/$defs/RoleRules"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "portalRole",
        "rules"
      ],
      "description": "Named tenant role with fixed templates and bounded permission rules."
    },
    "ControlRolePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
