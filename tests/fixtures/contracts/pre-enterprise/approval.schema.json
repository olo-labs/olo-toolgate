{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/approval.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ApprovalRecord",
  "$ref": "#/$defs/ApprovalRecord",
  "$defs": {
    "ApprovalState": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED_ONCE",
        "APPROVED_TEMPORARY",
        "DENIED",
        "EXPIRED",
        "CONSUMED"
      ]
    },
    "ApprovalChoice": {
      "type": "string",
      "enum": [
        "APPROVE_ONCE",
        "APPROVE_TEMPORARY",
        "DENY"
      ]
    },
    "ApprovalSubmission": {
      "type": "object",
      "description": "Gateway-only normalized ASK request. No raw arguments or credentials.",
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "policy.schema.json#/$defs/PolicyInput"
        },
        "policyVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "input",
        "policyVersion"
      ]
    },
    "ApprovalDecisionRequest": {
      "type": "object",
      "description": "Optimistic human decision; duration is required only for temporary approval.",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "approval.schema.json#/$defs/ApprovalChoice"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        }
      },
      "required": [
        "decision",
        "expectedRevision"
      ]
    },
    "ApprovalRecord": {
      "type": "object",
      "description": "Durable tenant approval status; identity/resource and digest only, never raw arguments.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "$ref": "approval.schema.json#/$defs/ApprovalState"
        },
        "input": {
          "$ref": "policy.schema.json#/$defs/PolicyInput"
        },
        "policyVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "createdAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decidedBy": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "decidedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "input",
        "policyVersion",
        "createdAtUnixMs",
        "expiresAtUnixMs"
      ]
    },
    "ApprovalPage": {
      "type": "object",
      "description": "Bounded tenant-scoped approval page.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "approval.schema.json#/$defs/ApprovalRecord"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "items"
      ]
    },
    "ApprovalResolution": {
      "type": "object",
      "description": "Authenticated Control result for this exact Gateway attempt; lease fields occur only on a successful grant.",
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "state": {
          "$ref": "approval.schema.json#/$defs/ApprovalState"
        },
        "input": {
          "$ref": "policy.schema.json#/$defs/PolicyInput"
        },
        "policyVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "permitId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "permitExpiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "approvalId",
        "state",
        "input",
        "policyVersion"
      ]
    },
    "ApprovalPermitUse": {
      "type": "object",
      "description": "Gateway-only atomic lease consumption; repeat use never grants again.",
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "permitId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "input": {
          "$ref": "policy.schema.json#/$defs/PolicyInput"
        },
        "policyVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "approvalId",
        "permitId",
        "input",
        "policyVersion"
      ]
    },
    "ExecutionPermitHeader": {
      "type": "object",
      "description": "Dedicated runtime permit trust domain; no key negotiation or remote keys.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "const": "RS256"
        },
        "typ": {
          "type": "string",
          "const": "toolgate-execution-permit+jws"
        },
        "kid": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ]
    },
    "ExecutionPermitClaims": {
      "type": "object",
      "description": "Exact-operation capability; maximum ten seconds; authoritative consume boundary enforces replay.",
      "additionalProperties": false,
      "properties": {
        "permitVersion": {
          "type": "integer",
          "const": 1
        },
        "issuer": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "audience": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "userId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "resource": {
          "$ref": "resource.schema.json#/$defs/ResourceDescriptor"
        },
        "argumentsDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "policyVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "approvalId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "jti": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "issuedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "permitVersion",
        "issuer",
        "audience",
        "tenantId",
        "userId",
        "agentId",
        "toolId",
        "action",
        "resource",
        "argumentsDigest",
        "requestId",
        "policyVersion",
        "approvalId",
        "jti",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ]
    },
    "SignedExecutionPermit": {
      "type": "object",
      "description": "RS256 compact JWS; structural validation alone does not establish trust.",
      "additionalProperties": false,
      "properties": {
        "jws": {
          "type": "string",
          "minLength": 20,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "jws"
      ]
    },
    "ExecutionPermitUseRequest": {
      "type": "object",
      "description": "Authenticated runtime request to verify and atomically consume one exact-bound permit.",
      "additionalProperties": false,
      "properties": {
        "permit": {
          "$ref": "approval.schema.json#/$defs/SignedExecutionPermit"
        },
        "request": {
          "$ref": "runtime.schema.json#/$defs/AuthorizationRequest"
        }
      },
      "required": [
        "permit",
        "request"
      ]
    },
    "AuthorizationOutcome": {
      "type": "object",
      "description": "V2 ASK outcome; pending ASK grants no execution; ALLOW for approved ASK requires a signed permit.",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "policy.schema.json#/$defs/PolicyDecision"
        },
        "approvalId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "permit": {
          "$ref": "approval.schema.json#/$defs/SignedExecutionPermit"
        }
      },
      "required": [
        "decision"
      ]
    },
    "ApprovalBundleRule": {
      "type": "object",
      "description": "Format 2 exact rule; BLOCK > ASK > ALLOW. ASK never uses grace.",
      "additionalProperties": false,
      "properties": {
        "policyId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "resource": {
          "$ref": "resource.schema.json#/$defs/ResourceDescriptor"
        },
        "graceAllowed": {
          "type": "boolean",
          "description": "Explicit administrator classification as a low-risk read; never inferred from operation names."
        },
        "effect": {
          "$ref": "policy.schema.json#/$defs/Decision"
        }
      },
      "required": [
        "policyId",
        "userIds",
        "agentIds",
        "deviceIds",
        "toolId",
        "action",
        "resource",
        "graceAllowed",
        "effect"
      ]
    },
    "ApprovalCompiledPolicy": {
      "type": "object",
      "description": "Format 2 adds human approval without weakening default deny.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 2
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "approval.schema.json#/$defs/ApprovalBundleRule"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "formatVersion",
        "rules"
      ]
    },
    "ApprovalBundlePayload": {
      "type": "object",
      "description": "Signed format 2 envelope; compilation adds ASK; old readers reject safely.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 2
        },
        "issuer": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "audience": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "directoryRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "policySha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "policy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 1048576
        },
        "rollbackOf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "formatVersion",
        "issuer",
        "audience",
        "tenantId",
        "sequence",
        "version",
        "directoryRevision",
        "issuedAtUnixMs",
        "expiresAtUnixMs",
        "graceMs",
        "policySha256",
        "policy"
      ]
    }
  }
}
