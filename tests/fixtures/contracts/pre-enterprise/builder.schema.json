{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/builder.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Custom tool authoring and designated sandbox tests",
  "$ref": "#/$defs/BuilderDraft",
  "$defs": {
    "LocalToolSource": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "code",
        "sha256"
      ]
    },
    "BuilderPermission": {
      "type": "string",
      "enum": [
        "COMPUTE",
        "FILE_READ",
        "FILE_WRITE",
        "NETWORK",
        "CREDENTIALS"
      ]
    },
    "BuilderDefinition": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "useWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "doNotUseWhen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "runtime": {
          "$ref": "execution.schema.json#/$defs/ManagedRuntime"
        },
        "tool": {
          "$ref": "execution.schema.json#/$defs/LocalToolRegistration"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "endpoint.schema.json#/$defs/ClientPlatform"
          },
          "maxItems": 3
        },
        "architectures": {
          "type": "array",
          "items": {
            "$ref": "fleet.schema.json#/$defs/FleetArchitecture"
          },
          "maxItems": 2
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "fleet.schema.json#/$defs/FleetSelfTest"
          },
          "maxItems": 8
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "builder.schema.json#/$defs/BuilderPermission"
          },
          "maxItems": 8
        },
        "resource": {
          "$ref": "resource.schema.json#/$defs/ResourceDescriptor"
        },
        "credentialRequirements": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/SecretReference"
          },
          "maxItems": 8
        }
      },
      "required": [
        "packageId",
        "version",
        "name",
        "description",
        "useWhen",
        "doNotUseWhen",
        "runtime",
        "tool",
        "platforms",
        "architectures",
        "examples",
        "permissions",
        "resource",
        "credentialRequirements"
      ]
    },
    "BuilderDraftRequest": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "definition": {
          "$ref": "builder.schema.json#/$defs/BuilderDefinition"
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "definition"
      ]
    },
    "BuilderDraft": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition": {
          "$ref": "builder.schema.json#/$defs/BuilderDefinition"
        },
        "definitionDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "sealed": {
          "type": "boolean"
        },
        "packageDocument": {
          "$ref": "fleet.schema.json#/$defs/FleetPackageDocument"
        }
      },
      "required": [
        "id",
        "revision",
        "definition",
        "definitionDigest",
        "sealed",
        "packageDocument"
      ]
    },
    "BuilderDraftPage": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "builder.schema.json#/$defs/BuilderDraft"
          },
          "maxItems": 32
        },
        "nextCursor": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "items"
      ]
    },
    "BuilderTestState": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "PASSED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "BuilderTestRequest": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "draftId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "exampleIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "id",
        "draftId",
        "expectedRevision",
        "deviceId",
        "exampleIndex"
      ]
    },
    "BuilderTestRecord": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "draftId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "definitionDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "state": {
          "$ref": "builder.schema.json#/$defs/BuilderTestState"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "leaseId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "exampleIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "error": {
          "$ref": "error.schema.json#/$defs/ErrorCode"
        }
      },
      "required": [
        "id",
        "draftId",
        "definitionDigest",
        "deviceId",
        "state",
        "revision",
        "createdAtUnixMs",
        "expiresAtUnixMs",
        "attempt",
        "leaseId",
        "exampleIndex"
      ]
    },
    "BuilderTestPage": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "builder.schema.json#/$defs/BuilderTestRecord"
          },
          "maxItems": 32
        },
        "nextCursor": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "items"
      ]
    },
    "BuilderTestTask": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "const": 1
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "serverId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "job": {
          "$ref": "builder.schema.json#/$defs/BuilderTestRecord"
        },
        "definition": {
          "$ref": "builder.schema.json#/$defs/BuilderDefinition"
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "formatVersion",
        "tenantId",
        "serverId",
        "deviceId",
        "job",
        "definition",
        "expiresAtUnixMs"
      ]
    },
    "BuilderTestPoll": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "fleet.schema.json#/$defs/FleetSignedDocument"
        }
      },
      "required": []
    },
    "BuilderTestResult": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "leaseId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "definitionDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "success": {
          "type": "boolean"
        },
        "error": {
          "$ref": "error.schema.json#/$defs/ErrorCode"
        }
      },
      "required": [
        "jobId",
        "leaseId",
        "definitionDigest",
        "success"
      ]
    },
    "BuilderRevisionRequest": {
      "type": "object",
      "description": "Canonical bounded authoring protocol; declarations never grant execution privileges.",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expectedRevision"
      ]
    }
  }
}
