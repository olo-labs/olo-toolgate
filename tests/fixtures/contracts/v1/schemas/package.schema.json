{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/package.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "PackageManifest",
  "$ref": "#/$defs/PackageManifest",
  "$defs": {
    "ArtifactDescriptor": {
      "type": "object",
      "description": "Immutable artifact identity; digest must be verified by consumers.",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "uri",
        "sha256",
        "sizeBytes"
      ]
    },
    "PackageCompatibility": {
      "type": "object",
      "description": "Minimum supported contract and client versions.",
      "additionalProperties": false,
      "properties": {
        "contractsVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "minimumClientVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "contractsVersion",
        "minimumClientVersion"
      ]
    },
    "PackageManifest": {
      "type": "object",
      "description": "Portable package metadata. Credential values are forbidden.",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "tool.schema.json#/$defs/ToolDefinition"
          },
          "maxItems": 128
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/ArtifactDescriptor"
          },
          "maxItems": 128
        },
        "credentialReferences": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/SecretReference"
          },
          "maxItems": 128
        },
        "compatibility": {
          "$ref": "package.schema.json#/$defs/PackageCompatibility"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "tools",
        "artifacts",
        "credentialReferences",
        "compatibility"
      ]
    },
    "MarketplaceRelease": {
      "type": "object",
      "description": "Marketplace trust only; never organization or runtime authorization.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "manifestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "marketplaceKeyId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "marketplaceSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "packageId",
        "version",
        "manifestDigest",
        "marketplaceKeyId",
        "marketplaceSignature"
      ]
    }
  }
}
