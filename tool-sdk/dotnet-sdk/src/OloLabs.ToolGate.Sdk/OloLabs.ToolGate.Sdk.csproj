<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OloLabs.ToolGate.Sdk</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>OloLabs.ToolGate.Sdk</PackageId>
    <Description>ToolGate Tool SDK for .NET: authoring attributes, ToolContext, errors and the standalone and governed runtimes.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator and analyzers flow to every consumer of the SDK package. -->
    <ProjectReference Include="../OloLabs.ToolGate.Sdk.Analyzers/OloLabs.ToolGate.Sdk.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="build/**" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OloLabs.ToolGate.Sdk.Testing" />
    <InternalsVisibleTo Include="OloLabs.ToolGate.Sdk.Tests" />
  </ItemGroup>
</Project>
