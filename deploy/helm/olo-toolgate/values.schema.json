{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageRegistry", "imagePullSecrets"],
      "properties": {
        "imageRegistry": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:-]*$", "maxLength": 256},
        "imagePullSecrets": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name"],
            "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253}}
          }
        }
      }
    }
  }
}
